# ── App ──────────────────────────────────────────────
# NODE_ENV: não defina em deploy (Dokploy) — next build/start já usam production
PORT=3000
# Origem pública do app; em produção deve ser HTTPS acessível pelo provedor.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_LOCALE=pt-BR
APP_LOCALE=pt-BR

# ── Auth.js ──────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
# Em `pnpm dev`, AUTH_URL de um host público é ignorada: o proxy fica no
# host do pedido (localhost). NODE_ENV no .env não muda isso — o Next só
# usa development, production ou test, e `next dev` já é development.
# AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Só é aplicado em produção. Fora de produção, um domínio público é ignorado
# para o cookie de sessão não sair do localhost.
# AUTH_COOKIE_DOMAIN=.seu-dominio.com

# ── Postgres ─────────────────────────────────────────
DATABASE_URL=postgresql://zapp_root:zapp@localhost:5432/zapp_db?schema=public
# Sessão direta para o LISTEN do chat. Obrigatória se DATABASE_URL for pooler (porta 6543 ou pgbouncer=true).
# DIRECT_DATABASE_URL=postgresql://zapp_root:zapp@localhost:5432/zapp_db?schema=public

# ── Criptografia (credenciais WhatsApp / AI keys no DB) ─
# openssl rand -hex 32
ENCRYPTION_KEY=

# ── WhatsApp: WuzAPI por conta ───────────────────────
# Base real da API, incluindo eventual prefixo da instalação; não é a URL da documentação.
WUZAPI_BASE_URL=
# Token admin da instalação WuzAPI (criar/listar/apagar usuários). Aceita alias WUZAPI_API_KEY.
WUZAPI_ADMIN_TOKEN=
# URL completa opcional; ausente: origem de NEXT_PUBLIC_SITE_URL + /webhook/whatsapp.
# WUZAPI_WEBHOOK_URL=https://app.seu-dominio.com/webhook/whatsapp
# O token da conta (usuário WuzAPI) é cadastrado criptografado no servidor, não nesta env.

# ── Cloudflare R2 — obrigatório para upload de mídia ─
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zapp
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ── SendGrid — opcional (convites por e-mail) ────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@seu-dominio.com

# ── Cron — recomendado em produção ───────────────────
# openssl rand -hex 16
AUTOMATION_CRON_SECRET=

# ── Opcional ─────────────────────────────────────────
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20

# ── Seed admin (pnpm db:seed) ────────────────────────
# SEED_ADMIN_CPF=52998224725
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Admin
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_RESET=1
