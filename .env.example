# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_LOCALE=pt-BR
APP_LOCALE=pt-BR

# ── Auth.js ──────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
# AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# AUTH_COOKIE_DOMAIN=.seu-dominio.com

# ── Postgres ─────────────────────────────────────────
DATABASE_URL=postgresql://wacrm:wacrm@localhost:5432/wacrm?schema=public

# ── Criptografia (tokens WAHA / AI keys no DB) ───────
# openssl rand -hex 32
ENCRYPTION_KEY=

# ── WAHA (WhatsApp) — obrigatório para inbox ─────────
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=
# openssl rand -hex 32
WAHA_WEBHOOK_SECRET=
# WAHA_WEBHOOK_URL=http://localhost:3000/api/whatsapp/webhook

# ── Cloudflare R2 — obrigatório para upload de mídia ─
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wacrm
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ── SendGrid — opcional (convites por e-mail) ────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@seu-dominio.com

# ── Meta Cloud API — templates / webhook HMAC ────────
META_APP_ID=
META_APP_SECRET=

# ── Cron — recomendado em produção ───────────────────
# openssl rand -hex 16
AUTOMATION_CRON_SECRET=

# ── Opcional ─────────────────────────────────────────
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20
# ALLOWED_INVITE_HOSTS=
# WAHA_TEMPLATES_DRY_RUN=true

# ── Seed admin (pnpm db:seed) ────────────────────────
# SEED_ADMIN_CPF=52998224725
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Admin
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_RESET=1
