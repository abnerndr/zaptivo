{
  "name": "wacrm",
  "version": "0.8.0",
  "private": true,
  "description": "Self-hostable CRM for WhatsApp — Turborepo monorepo (Next.js web + NestJS api + Prisma).",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@wacrm/web",
    "dev:api": "turbo run dev --filter=@wacrm/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo run db:generate --filter=@wacrm/database",
    "db:migrate": "pnpm --filter @wacrm/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @wacrm/database db:migrate:deploy",
    "db:seed": "pnpm --filter @wacrm/database db:seed",
    "db:studio": "pnpm --filter @wacrm/database db:studio",
    "db:push": "pnpm --filter @wacrm/database db:push"
  },
  "devDependencies": {
    "prettier": "^3.9.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
